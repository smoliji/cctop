{
  "name": "@smoliji/cctop",
  "version": "0.1.0",
  "description": "A htop-like terminal dashboard for your local Claude Code usage.",
  "license": "MIT",
  "author": "Jiří Šmolík",
  "keywords": ["claude", "claude-code", "cli", "dashboard", "tui", "usage"],
  "type": "module",
  "bin": {
    "cctop": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoliji/cctop.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.tsx",
    "prices": "tsx scripts/update-prices.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
